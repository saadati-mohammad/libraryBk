# Library backend — example environment file.
# Copy to .env (or export these) and fill in real values. NEVER commit real secrets.

# --- Database ---
DB_URL=jdbc:h2:mem:librarydb;
DB_USERNAME=sa
DB_PASSWORD=
# For production, disable ddl-auto and use migrations.
JPA_DDL_AUTO=update
JPA_DIALECT=org.hibernate.dialect.H2Dialect

# --- Security ---
# Required in production; generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400

# --- CORS / WebSocket ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
WS_ALLOWED_ORIGINS=http://localhost:4200

# --- Mail (optional) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- File uploads ---
UPLOAD_DIR=
UPLOAD_MAX_FILE_SIZE=10485760

# --- Optional license gate (leave disabled unless you actually need it) ---
APP_LICENSE_ENABLED=false
APP_LICENSE_INTERACTIVE=false
APP_LICENSE_KEY=
