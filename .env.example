# Library backend — example environment file.
#
# Copy to .env (or export these) and fill in real values. NEVER commit real secrets.
# Every variable below is actually referenced by src/main/resources/application*.properties
# (plus APP_LICENSE_KEY, which ir.iau.library.config.KeyPromptValidator reads from the
# environment), so this file is the complete external configuration surface.
# The value after "=" shows the built-in default; leave it empty to use that default.

# --- Server ---
# Port the API listens on (8080 is commonly taken; 8079 is the project dev/test port).
SERVER_PORT=8079
# development | production
SPRING_PROFILES_ACTIVE=development

# --- Database ---
# Development defaults use ephemeral H2. Production requires all three MySQL values.
DB_URL=jdbc:h2:mem:librarydb;
DB_USERNAME=sa
DB_PASSWORD=
# Schema is owned by Flyway (db/migration); Hibernate must only VALIDATE it.
# Never set this to update/create in any environment you care about.
JPA_DDL_AUTO=validate
JPA_DIALECT=org.hibernate.dialect.H2Dialect
FLYWAY_ENABLED=true
# Anti-pattern: opens a session per lazy access outside a transaction. Leave off.
ENABLE_LAZY_LOAD_NO_TRANS=false
# Expose the H2 web console (development only).
H2_CONSOLE_ENABLED=false

# Production MySQL example (set only in the deployment secret store):
# SPRING_PROFILES_ACTIVE=production
# DB_URL=jdbc:mysql://<host>:3306/<database>?useSSL=true&serverTimezone=UTC
# DB_USERNAME=<database-user>
# DB_PASSWORD=<secret>
# JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# --- Security ---
# Required in production; at least 32 bytes for HS256. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400
# Operator credential for the back-office API. Required (no default) in production.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# --- CORS / WebSocket ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# --- File uploads ---
UPLOAD_DIR=
UPLOAD_MAX_FILE_SIZE=10485760

# --- Background jobs ---
CLEANUP_ENABLED=true
CLEANUP_CRON=0 0 2 * * *
CLEANUP_DELETE_FILES_OLDER_THAN_DAYS=30
RESERVATION_EXPIRE_CRON=0 0 2 * * *
LOAN_OVERDUE_CRON=0 0 2 * * *

# --- Optional license gate (leave disabled unless you actually need it) ---
APP_LICENSE_ENABLED=false
APP_LICENSE_INTERACTIVE=false
APP_LICENSE_KEY=
